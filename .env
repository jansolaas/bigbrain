
 # URL for the main database
DATABASE_URL=sqlite:///./bigbrain.db

PYTHONPATH=./backend

# The port where FastAPI should run
BACKEND_PORT=9000

# Used in run_uvicorn
BACKEND_HOST=127.0.0.1
UVICORN_WORKERS=2
UVICORN_RELOAD=true


# JWT-related variables
SECRET_KEY=you_should_change_this
ALGORITHM=HS256
